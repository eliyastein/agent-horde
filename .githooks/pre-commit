#!/bin/bash
# Refuse a commit under a non-public identity, or whose staged changes carry a home-directory
# path or a pattern the maintainer keeps private in git config (hooks.privatePattern), never here.
set -euo pipefail
allowed_email="16121304+eliyastein@users.noreply.github.com"
for ident in "$(git var GIT_AUTHOR_IDENT)" "$(git var GIT_COMMITTER_IDENT)"; do
  if [[ "$ident" != *"<$allowed_email>"* ]]; then
    echo "pre-commit: identity '$ident' is not the public one; this repo expects <$allowed_email>" >&2
    exit 1
  fi
done
# Assembled from pieces so this file does not match its own check.
home_path='(/Us''ers|/ho''me)/[A-Za-z0-9._-]+'
private=$(git config --get hooks.privatePattern || true)
staged=$(git diff --cached -U0)
if hits=$(grep -n -E -- "$home_path" <<<"$staged"); then
  echo "pre-commit: staged changes contain a home-directory path:" >&2; echo "$hits" | head -10 >&2; exit 1
fi
if [[ -n "$private" ]] && hits=$(grep -n -i -E -- "$private" <<<"$staged"); then
  echo "pre-commit: staged changes match the private pattern from git config:" >&2; echo "$hits" | head -10 >&2; exit 1
fi
